  full_scale_qubits: {{ opportunity.quantum_kernel.full_scale_qubits }}
  feasible_qubits: {{ opportunity.quantum_kernel.feasible_qubits }}
  needs_reduction: {{ opportunity.quantum_kernel.needs_reduction }}
